  console.log(`❌ Функція findOffersNearHomeUnloading застаріла - відстані мають розраховуватися через API endpoints`);
  throw new Error(`❌ Пошук оферів поблизу дому заборонено. Відстані мають бути отримані виключно з API endpoints.`);
}

/**
 * Рекурсивний пошук оптимальних маршрутів будь-якої довжини
 */
interface RouteSearchState {
  currentRoute: GeocodedOffer[];
  usedOfferIds: Set<string>;
  availableOffers: GeocodedOffer[];
  endOffers: Array<{ offer: GeocodedOffer; distance: number }>;
  config: OptimizationConfig;
  startTime: number;
  foundRoutes: RouteCandidate[];
}

/**
 * Рекурсивна функція для пошуку маршрутів
 */
async function findRoutesRecursively(state: RouteSearchState): Promise<void> {
  const { currentRoute, usedOfferIds, availableOffers, endOffers, config, startTime, foundRoutes } = state;
  
  // Перевірка часу виконання
  if (config.maxSearchTimeMs && (Date.now() - startTime) > config.maxSearchTimeMs) {
    console.log(`⏰ Досягнуто ліміт часу пошуку: ${config.maxSearchTimeMs}ms`);
    return;
  }

  // Перевірка максимальної глибини
  if (config.maxRouteDepth && currentRoute.length >= config.maxRouteDepth) {
    console.log(`📏 Досягнуто максимальну глибину маршруту: ${config.maxRouteDepth}`);
    return;
  }

  // Перевірка максимальної кількості результатів
  if (config.maxResults && foundRoutes.length >= config.maxResults) {
    console.log(`📊 Досягнуто максимальну кількість результатів: ${config.maxResults}`);
    return;
  }

  const lastOffer = currentRoute[currentRoute.length - 1];
  const lastUnloading = getUnloadingCoordinates(lastOffer);

  // 1. Спробуємо завершити маршрут (якщо останній офер розвантажується поблизу дому)
  try {
    const homeBaseCoords = {
      lat: config.homeBase.latitude,
      lon: config.homeBase.longitude,
      locality: config.homeBase.locality,
      country: config.homeBase.country,
      postalCode: config.homeBase.postalCode
    };
    
    await throwDistanceCalculationError(lastUnloading, homeBaseCoords);
    
    // Якщо повернення додому в межах розумного (300 км), це валідний кінець маршруту
    if (returnDistance <= 300) {
      try {
        const route = await buildRoute([...currentRoute], config);
        // НЕ фільтруємо за порожнім пробігом тут - тільки додаємо до результатів
        foundRoutes.push(route);
        console.log(`✅ Знайдено маршрут з ${currentRoute.length} оферів, score: ${route.score.toFixed(2)}, порожній пробіг: ${route.emptyRunPercent.toFixed(1)}%`);
      } catch (error) {
        console.warn(`⚠️ Помилка побудови маршруту з ${currentRoute.length} оферів:`, error);
      }
    }
  } catch (error) {
    console.warn(`⚠️ Помилка розрахунку відстані повернення додому:`, error);
  }

  // 2. Спробуємо продовжити маршрут (додати ще один офер)
  const nextOfferCandidates: Array<{ offer: FreightOffer; distance: number }> = [];
  
  // Знаходимо всі доступні офери, які можна додати до поточного маршруту
  for (const offer of availableOffers) {
    if (usedOfferIds.has(offer.id)) continue;
    
    try {
      const nextLoading = getLoadingCoordinates(offer);
      await throwDistanceCalculationError(lastUnloading, nextLoading);
      
      // Перевіряємо обмеження
      const maxEmptyDistance = config.maxEmptyDistanceKm || 200;
      if (emptyDistance > maxEmptyDistance) continue;
      
      // Перевіряємо часові обмеження
      if (!isTimeValid(lastOffer, offer)) continue;
      
      nextOfferCandidates.push({ offer, distance: emptyDistance });
    } catch (error) {
      console.warn(`⚠️ Пропускаємо офер ${offer.id} через помилку геокодування:`, error);
    }
  }

  // Сортуємо кандидатів за відстанню (найближчі спочатку)
  nextOfferCandidates.sort((a, b) => a.distance - b.distance);

  // Обмежуємо кількість кандидатів для оптимізації продуктивності
  const maxCandidates = Math.max(10, Math.floor(50 / (currentRoute.length + 1))); // Менше кандидатів для довших маршрутів
  const limitedCandidates = nextOfferCandidates.slice(0, maxCandidates);

  console.log(`🔍 Маршрут глибини ${currentRoute.length}: знайдено ${limitedCandidates.length} кандидатів для продовження`);

  // 3. Рекурсивно досліджуємо кожного кандидата
  for (const candidate of limitedCandidates) {
    // Перевірка часу виконання перед кожною рекурсією
    if (config.maxSearchTimeMs && (Date.now() - startTime) > config.maxSearchTimeMs) {
      break;
    }

    const newRoute = [...currentRoute, candidate.offer];
    const newUsedIds = new Set(usedOfferIds);
    newUsedIds.add(candidate.offer.id);

    const newState: RouteSearchState = {
      currentRoute: newRoute,
      usedOfferIds: newUsedIds,
      availableOffers,
      endOffers,
      config,
      startTime,
      foundRoutes
    };

    await findRoutesRecursively(newState);
  }
}

/**
 * ЗАСТАРІЛА ФУНКЦІЯ: Пошук найкращих стартових оферів більше не підтримується
 * Відстані мають розраховуватися виключно через API endpoints
 */
async function findBestStartingOffers(
  offers: FreightOffer[], 
  homeBase: RoutePoint, 
  maxDistance: number = 300,
  maxCount: number = 20
): Promise<Array<{ offer: FreightOffer; distance: number; score: number }>> {
  console.log(`❌ Функція findBestStartingOffers застаріла - відстані мають розраховуватися через API endpoints`);
  throw new Error(`❌ Пошук стартових оферів заборонено. Відстані мають бути отримані виключно з API endpoints.`);
}

/**
 * ЗАСТАРІЛА ФУНКЦІЯ: Розрахунок відстані повернення додому більше не підтримується
 * Відстані мають розраховуватися виключно через API endpoints
 */
async function calculateReturnDistance(lastOffer: FreightOffer, homeBase: RoutePoint): Promise<never> {
  const unloading = getUnloadingCoordinates(lastOffer);
  
  const homeBaseCoords = {
    locality: homeBase.locality,
    country: homeBase.country
  };
  
  await throwDistanceCalculationError(unloading, homeBaseCoords);
}

/**
 * Побудова маршруту з ланцюжка пропозицій з правильним розрахунком порожнього пробігу
 * Порожній пробіг = ВСЕ що не оплачується: дім→завантаження + переїзди + розвантаження→дім
 * Фільтрація за відсотком порожнього пробігу відбувається тільки на фінальному етапі
 */
async function buildRoute(offers: FreightOffer[], config: OptimizationConfig): Promise<RouteCandidate> {
  const segments: RouteSegment[] = [];
  let totalDistance = 0;
  let loadedDistance = 0;
  let totalEmptyDistance = 0; // Весь порожній пробіг
  let totalEarnings = 0;

  try {
    // 1. Відстань від дому до першої точки завантаження (порожній пробіг)
    let homeToFirstLoadingDistance = 0;
    if (offers.length > 0) {
      const firstLoading = getLoadingCoordinates(offers[0]);
      const homeBaseCoords = {
        lat: config.homeBase.latitude,
        lon: config.homeBase.longitude,
        locality: config.homeBase.locality,
        country: config.homeBase.country,
        postalCode: config.homeBase.postalCode
      };
      
      await throwDistanceCalculationError(homeBaseCoords, firstLoading);
      totalEmptyDistance += homeToFirstLoadingDistance;
      totalDistance += homeToFirstLoadingDistance;
      console.log(`🏠→📦 Дім до першого завантаження: ${homeToFirstLoadingDistance} км (порожній)`);
    }

    // 2. Обробляємо кожну пропозицію
    for (let i = 0; i < offers.length; i++) {
      const offer = offers[i];
      let emptyDistanceToReach = 0;

      // Якщо це не перша пропозиція, розраховуємо порожню відстань до неї
      if (i > 0) {
        const prevUnloading = getUnloadingCoordinates(offers[i - 1]);
        const currentLoading = getLoadingCoordinates(offer);
        await throwDistanceCalculationError(prevUnloading, currentLoading);
        totalEmptyDistance += emptyDistanceToReach; // Додаємо до загального порожнього пробігу
        totalDistance += emptyDistanceToReach;
        console.log(`�→📦 Переїзд ${i-1}→${i}: ${emptyDistanceToReach} км (порожній)`);
      }

      // Створюємо сегмент
      const segment = await createRouteSegment(offer, config, emptyDistanceToReach);
      segments.push(segment);

      // Додаємо до загальних показників
      loadedDistance += segment.distanceKm;
      totalDistance += segment.distanceKm;
      console.log(`📦→🏭 Завантажений сегмент ${i}: ${segment.distanceKm} км (оплачується)`);
      
      if (offer.price.value) {
        totalEarnings += offer.price.value;
      }
    }

    // 3. Відстань повернення додому (порожній пробіг)
    let lastUnloadingToHomeDistance = 0;
    if (offers.length > 0) {
      lastUnloadingToHomeDistance = await calculateReturnDistance(offers[offers.length - 1], config.homeBase);
      totalEmptyDistance += lastUnloadingToHomeDistance;
      totalDistance += lastUnloadingToHomeDistance;
      console.log(`🏭→🏠 Останнє розвантаження до дому: ${lastUnloadingToHomeDistance} км (порожній)`);
    }

    // 4. Розрахунок відсотка порожнього пробігу від ЗАГАЛЬНОЇ відстані
    const emptyRunPercent = totalDistance > 0 ? (totalEmptyDistance / totalDistance) * 100 : 0;

    // 5. Розрахунок score (вищий = кращий)
    // Враховуємо: більше завантажених км, менше порожнього пробігу, більший прибуток
    const score = loadedDistance * 10 - totalEmptyDistance * 3 + totalEarnings * 0.1;

    console.log(`📊 Маршрут з ${offers.length} оферів:`);
    console.log(`   📏 Загальна відстань: ${totalDistance.toFixed(1)} км`);
    console.log(`   📦 Завантажена відстань: ${loadedDistance.toFixed(1)} км`);
    console.log(`   🚛 Порожній пробіг: ${totalEmptyDistance.toFixed(1)} км (${emptyRunPercent.toFixed(1)}%)`);
    console.log(`   💰 Заробіток: ${totalEarnings.toFixed(2)} EUR`);
    console.log(`   ⭐ Score: ${score.toFixed(2)}`);

    return {
      offers,
      totalDistance,
      loadedDistance,
      totalEmptyDistance,
      emptyRunPercent,
      totalEarnings,
      score
    };
  } catch (error) {
    console.error(`❌ Помилка побудови маршруту з оферів [${offers.map(o => o.id).join(', ')}]:`, error);
    throw new Error(`Неможливо побудувати маршрут: ${error instanceof Error ? error.message : String(error)}`);
  }
}

/**
 * Конвертація кандидата в OptimizedRoute з правильним розрахунком порожнього пробігу
 */
async function convertToOptimizedRoute(candidate: RouteCandidate, config: OptimizationConfig): Promise<OptimizedRoute> {
  const segments: RouteSegment[] = [];
  
  for (let index = 0; index < candidate.offers.length; index++) {
    const offer = candidate.offers[index];
    let emptyDistanceToReach = 0;
    
    if (index === 0) {
      const firstLoading = getLoadingCoordinates(offer);
      const homeBaseCoords = {
        lat: config.homeBase.latitude,
        lon: config.homeBase.longitude,
        locality: config.homeBase.locality,
        country: config.homeBase.country,
        postalCode: config.homeBase.postalCode
      };
      await throwDistanceCalculationError(homeBaseCoords, firstLoading);
    } else {
      const prevUnloading = getUnloadingCoordinates(candidate.offers[index - 1]);
      const currentLoading = getLoadingCoordinates(offer);
      await throwDistanceCalculationError(prevUnloading, currentLoading);
    }
    
    const segment = await createRouteSegment(offer, config, emptyDistanceToReach);
    segments.push(segment);
  }

  const totalDrivingHours = segments.reduce((sum, seg) => sum + seg.drivingHours, 0);
  const totalDays = Math.max(1, totalDrivingHours / 8); 
  const mandatoryBreaks = segments.reduce((sum, seg) => sum + seg.restStops, 0);
  const totalRestHours = mandatoryBreaks * 0.75; 
  const idleHours = Math.max(0, totalDays * 24 - totalDrivingHours - totalRestHours - (totalDays * 11)); 
  const weeklyRestsNeeded = Math.floor(totalDays / 7);

  const avgDailyDriving = totalDrivingHours / totalDays;
  const euCompliant = avgDailyDriving <= 9 && candidate.emptyRunPercent <= config.maxEmptyRunPercent;

  return {
    segments,
    totalDistanceKm: candidate.totalDistance,
    loadedDistanceKm: candidate.loadedDistance,
    emptyDistanceKm: candidate.totalEmptyDistance, // Використовуємо правильний розрахунок
    emptyRunPercent: candidate.emptyRunPercent,
    totalDays,
    idleHours,
    totalDrivingHours,
    totalRestHours,
    mandatoryBreaks,
    weeklyRestsNeeded,
    score: candidate.score,
    euCompliant
  };
}

/**
 * ЗАСТАРІЛА ФУНКЦІЯ: Оптимізація маршрутів більше не підтримується
 * Відстані мають розраховуватися виключно через API endpoints
 */
/**
 * Оптимізована функція оптимізації маршрутів з пре-геокодуванням
 * Вирішує проблему продуктивності - геокодування робиться один раз перед пошуком
 */
export async function optimizeRoutesWithPreGeocoding(
  offers: FreightOffer[], 
  config: OptimizationConfig
): Promise<OptimizedRoute[]> {
  console.log(`🚀 Початок оптимізованої оптимізації маршрутів: ${offers.length} пропозицій`);
  console.log(`🏠 Домашня база: ${config.homeBase.locality} (${config.homeBase.latitude}, ${config.homeBase.longitude})`);
  console.log(`⚙️ Параметри: maxDepth=${config.maxRouteDepth || 'необмежено'}, maxEmptyDistance=${config.maxEmptyDistanceKm || 200}км, maxTime=${config.maxSearchTimeMs || 'необмежено'}ms`);
  
  if (offers.length === 0) return [];

  const startTime = Date.now();
  const foundRoutes: RouteCandidate[] = [];
  const errors: string[] = [];
  
  try {
    // 1. ПРЕ-ГЕОКОДУВАННЯ - це ключ до продуктивності!
    console.log(`🌍 Етап 1: Пре-геокодування всіх оферів...`);
    const geocodedOffers = await preGeocodeOffers(offers);
    console.log(`✅ Геокодування завершено: ${geocodedOffers.length}/${offers.length} оферів готові`);

    // 2. Знаходимо найкращі стартові офери (тепер швидко!)
    const startingOffers = await findBestStartingOffersGeocoded(geocodedOffers, config.homeBase, 300, 15);
    console.log(`📍 Знайдено ${startingOffers.length} найкращих стартових оферів`);

    if (startingOffers.length === 0) {
      throw new Error(`❌ Не знайдено жодної пропозиції для завантаження поблизу домашньої бази (${config.homeBase.locality}). Неможливо побудувати маршрути.`);
    }

    // 3. Знаходимо офери, які можуть завершувати маршрути (тепер швидко!)
    const endOffers = await findOffersNearHomeUnloadingGeocoded(geocodedOffers, config.homeBase, 300);
    console.log(`📍 Знайдено ${endOffers.length} оферів для завершення маршрутів`);

    // 4. Рекурсивний пошук маршрутів для кожного стартового офера (тепер швидко!)
    for (let i = 0; i < startingOffers.length; i++) {
      const startingOffer = startingOffers[i];
      
      // Перевірка часу виконання
      if (config.maxSearchTimeMs && (Date.now() - startTime) > config.maxSearchTimeMs) {
        console.log(`⏰ Досягнуто ліміт часу пошуку при обробці стартового офера ${i + 1}/${startingOffers.length}`);
        break;
      }

      console.log(`🔄 Досліджуємо стартовий офер ${i + 1}/${startingOffers.length}: ${startingOffer.offer.id} (score: ${startingOffer.score.toFixed(2)})`);

      try {
        const initialState: RouteSearchState = {
          currentRoute: [startingOffer.offer],
          usedOfferIds: new Set([startingOffer.offer.id]),
          availableOffers: geocodedOffers,
          endOffers,
          config,
          startTime,
          foundRoutes
        };

        await findRoutesRecursivelyOptimized(initialState);
        
        console.log(`✅ Завершено дослідження стартового офера ${startingOffer.offer.id}. Знайдено маршрутів: ${foundRoutes.length}`);
        
      } catch (error) {
        const errorMsg = `Стартовий офер ${startingOffer.offer.id}: ${error instanceof Error ? error.message : String(error)}`;
        errors.push(errorMsg);
        console.warn(`⚠️ Помилка при дослідженні стартового офера ${startingOffer.offer.id}:`, error);
      }

      // Перевірка максимальної кількості результатів
      if (config.maxResults && foundRoutes.length >= config.maxResults) {
        console.log(`📊 Досягнуто максимальну кількість результатів: ${config.maxResults}`);
        break;
      }
    }

    const searchTime = Date.now() - startTime;
    console.log(`🔧 Оптимізований пошук завершено за ${searchTime}ms. Створено ${foundRoutes.length} кандидатів маршрутів`);
    
    if (errors.length > 0) {
      console.warn(`⚠️ Виникло ${errors.length} помилок під час побудови маршрутів`);
    }

    if (foundRoutes.length === 0) {
      if (errors.length > 0) {
        throw new Error(`❌ Жоден маршрут не вдалося побудувати через помилки геокодування. Перевірте доступність Trans.eu API та правильність адрес.`);
      } else {
        console.warn(`⚠️ Жоден маршрут не знайдено. Спробуйте збільшити maxEmptyRunPercent (зараз: ${config.maxEmptyRunPercent}%) або maxEmptyDistanceKm`);
      }
    }

    // 5. ФІНАЛЬНА ФІЛЬТРАЦІЯ за відсотком порожнього пробігу
    const validRoutes = foundRoutes.filter(route => {
      const isValid = route.emptyRunPercent <= config.maxEmptyRunPercent;
      if (!isValid) {
        console.log(`🚫 Відфільтровано маршрут з ${route.offers.length} оферів: порожній пробіг ${route.emptyRunPercent.toFixed(1)}% > ${config.maxEmptyRunPercent}%`);
      }
      return isValid;
    });

    console.log(`🔍 Після фільтрації за порожнім пробігом: ${validRoutes.length}/${foundRoutes.length} маршрутів`);

    if (validRoutes.length === 0) {
      console.warn(`⚠️ Всі маршрути відфільтровано через високий відсоток порожнього пробігу. Спробуйте збільшити maxEmptyRunPercent (зараз: ${config.maxEmptyRunPercent}%)`);
      return [];
    }

    // 6. Сортуємо за score та відбираємо найкращі
    const sortedRoutes = validRoutes
      .sort((a, b) => b.score - a.score)
      .slice(0, config.maxResults || 50);

    console.log(`✅ Відібрано ${sortedRoutes.length} найкращих маршрутів`);
    
    // Статистика по довжині маршрутів
    const routeLengthStats = sortedRoutes.reduce((stats, route) => {
      const length = route.offers.length;
      stats[length] = (stats[length] || 0) + 1;
      return stats;
    }, {} as Record<number, number>);
    
    console.log(`📊 Статистика довжини маршрутів:`, routeLengthStats);

    // 7. Конвертуємо в OptimizedRoute
    const optimizedRoutes: OptimizedRoute[] = [];
    for (const candidate of sortedRoutes) {
      try {
        const optimizedRoute = await convertToOptimizedRouteFromGeocoded(candidate, config);
        optimizedRoutes.push(optimizedRoute);
      } catch (error) {
        console.error(`❌ Помилка конвертації маршруту:`, error);
        errors.push(`Конвертація маршруту: ${error instanceof Error ? error.message : String(error)}`);
      }
    }

    const totalTime = Date.now() - startTime;
    console.log(`🎉 Оптимізована оптимізація завершена за ${totalTime}ms. Повернуто ${optimizedRoutes.length} оптимізованих маршрутів`);

    return optimizedRoutes;

  } catch (error) {
    console.error(`❌ Критична помилка оптимізованої оптимізації маршрутів:`, error);
    throw error;
  }
}

    // 5. Сортуємо за score та відбираємо найкращі
    const sortedRoutes = validRoutes
      .sort((a, b) => b.score - a.score)
      .slice(0, config.maxResults || 50);

    console.log(`✅ Відібрано ${sortedRoutes.length} найкращих маршрутів`);
    
    // Статистика по довжині маршрутів
    const routeLengthStats = sortedRoutes.reduce((stats, route) => {
      const length = route.offers.length;
      stats[length] = (stats[length] || 0) + 1;
      return stats;
    }, {} as Record<number, number>);
    
    console.log(`📊 Статистика довжини маршрутів:`, routeLengthStats);

    // 5. Конвертуємо в OptimizedRoute
    const optimizedRoutes: OptimizedRoute[] = [];
    for (const candidate of sortedRoutes) {
      try {
        const optimizedRoute = await convertToOptimizedRoute(candidate, config);
        optimizedRoutes.push(optimizedRoute);
      } catch (error) {
        console.error(`❌ Помилка конвертації маршруту:`, error);
        errors.push(`Конвертація маршруту: ${error instanceof Error ? error.message : String(error)}`);
      }
    }

    const totalTime = Date.now() - startTime;
    console.log(`🎉 Оптимізація завершена за ${totalTime}ms. Повернуто ${optimizedRoutes.length} оптимізованих маршрутів`);

    return optimizedRoutes;

  } catch (error) {
    console.error(`❌ Критична помилка рекурсивної оптимізації маршрутів:`, error);
    throw error;
  }
}

/**
 * ЗАСТАРІЛА ФУНКЦІЯ: Створення оптимізованих маршрутів більше не підтримується
 * Відстані мають розраховуватися виключно через API endpoints
 */
/**
 * Оптимізована експортована функція для використання в useRouteManagement
 * Використовує пре-геокодування для максимальної продуктивності
 */
export async function createOptimizedRoutes(
  offers: FreightOffer[],
  homeBase: RoutePoint,
  maxEmptyRunPercent: number = 10,
  pricePerKm: number = 1.5,
  averageSpeedKmh: number = 80,
  maxResults?: number,
  maxRouteDepth?: number,
  maxEmptyDistanceKm?: number,
  maxSearchTimeMs?: number
): Promise<OptimizedRoute[]> {
  const config: OptimizationConfig = {
    homeBase,
    maxEmptyRunPercent,
    pricePerKm,
    averageSpeedKmh,
    maxResults: maxResults || 50,
    maxRouteDepth: maxRouteDepth || 10, // За замовчуванням до 10 оферів в маршруті
    maxEmptyDistanceKm: maxEmptyDistanceKm || 200, // За замовчуванням до 200 км порожнього пробігу
    maxSearchTimeMs: maxSearchTimeMs || 30000 // За замовчуванням 30 секунд пошуку
  };

  return await optimizeRoutesWithPreGeocoding(offers, config);
}