# Trans.eu API Configuration
# Скопіюйте цей файл як .env та заповніть своїми даними

# JWT Token (найкращий спосіб - отримується після логіну)
TRANSEU_JWT_TOKEN=your_jwt_token_here

# API Key (альтернативний спосіб)
# TRANSEU_API_KEY=your_api_key_here

# OAuth2 Credentials (ще один альтернативний спосіб)
# TRANSEU_CLIENT_ID=your_client_id
# TRANSEU_CLIENT_SECRET=your_client_secret

# Proxy Configuration
PROXY_PORT=7740
NODE_ENV=development